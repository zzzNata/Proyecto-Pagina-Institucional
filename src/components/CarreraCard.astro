---
interface Props {
  titulo: string;
  duracion: string;
  modalidad: string;
  descripcion: string;
  id: string;
  pdf?: string;
}

const { titulo, duracion, modalidad, descripcion, id, pdf } = Astro.props;
---

<div class="bg-slate-700 border border-slate-600 rounded-2xl p-6 flex flex-col justify-between hover:shadow-lg hover:border-indigo-500/60 transition-all shadow-black/20">
  <div class="space-y-4">
    <div class="flex gap-2 flex-wrap">
      <span class="bg-slate-700 text-slate-200 text-xs font-medium px-2.5 py-1 rounded-md">{duracion}</span>
      <span class="bg-emerald-600/60 text-emerald-300 text-xs font-medium px-2.5 py-1 rounded-md">{modalidad}</span>
    </div>
    <h3 class="text-xl font-bold text-white">{titulo}</h3>
    <p class="text-slate-300 text-sm leading-relaxed">{descripcion}</p>
  </div>

  <div class="pt-6 mt-4 border-t border-slate-700 space-y-3">
    {pdf && (
      <a
        href={pdf}
        download
        class="inline-block w-full text-center bg-indigo-600 text-white font-semibold px-4 py-2.5 rounded-lg hover:bg-indigo-500 transition-colors"
      >
        Descargar información
      </a>
    )}

    <a href={`#contacto`} class="text-indigo-300 hover:text-indigo-200 font-semibold text-sm flex items-center gap-1">
      Comunícate con nosotros &rarr;
    </a>
  </div>
</div>